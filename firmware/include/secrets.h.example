#pragma once

// Copy this file to secrets.h (same folder) and fill it in. secrets.h is
// git-ignored so your WiFi password never ends up in the repo.
//
// Without a secrets.h the firmware still builds and runs in USB-only mode:
// face and head over the serial console, no WiFi, no brain.
//
// WIFI_SSID / WIFI_PASS / BRAIN_HOST are a one-time seed. The first boot that
// finds an empty NVS list copies them into the "wifi" namespace (up to four
// profiles later). Ordinary `pio run -t upload` keeps NVS, so the Mac hotspot
// stays after you change the image. A full chip erase (or partition change)
// wipes profiles; the next boot copies this seed again. After a successful
// migration you can leave the macros as they are — they are not used to join.
// `wifi` on the USB console lists SSIDs, never passwords. Namespaces "home"
// and "face" are not touched.
//
// If there are no saved networks, or none can be joined for about 60 seconds,
// Rocky starts a WPA2 access point named Rocky-Setup (http://192.168.4.1).
// That is 2.4 GHz only. SETUP_AP_PASS is never printed. The brain being down
// does not open setup.

#define WIFI_SSID "your-wifi-name"
#define WIFI_PASS "your-wifi-password"

// The computer running `python -m brain.main`. Find its IP with:
//   macOS: ipconfig getifaddr en0   Windows: ipconfig   Linux: hostname -I
// (Your router may let you pin that computer to a fixed address so this doesn't
// change. 2.4 GHz network required — the ESP32 can't see 5 GHz.)
#define BRAIN_HOST "192.168.1.50"
#define BRAIN_PORT 8765

// Shared secret so only your robot can talk to the brain. Put the same
// value in server/.env as ROBOT_TOKEN (any random string, e.g. from
// `python3 -c "import secrets; print(secrets.token_hex(16))"`).
#define ROBOT_TOKEN "change-me"

// WPA2 password for the Rocky-Setup access point (at least 8 characters).
// Not a Wi-Fi LAN password. Never committed; never printed on serial.
#define SETUP_AP_PASS "change-me-please"
