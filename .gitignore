# PlatformIO
firmware/.pio/
firmware/.vscode/

# Python
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
server/.venv/
.venv/
# ".venv/" does not match experiment envs such as .venv-vision
.venv*/

# Secrets — never commit WiFi or API credentials
firmware/include/secrets.h
.env
.env.*
!.env.example

# Private household facts injected into the prompt. See personal_context.example.txt.
server/personal_context.txt

# macOS and editors
.DS_Store
.vscode/
.idea/
*.code-workspace

# Logs and audio captures
*.log
*.wav

# Downloaded weights and model caches (Hugging Face, MLX, PyTorch).
# The YuNet face model already tracked under server/models/ stays tracked.
*.safetensors
*.gguf
*.pt
*.pth
*.ckpt
*.npz
.cache/

# Generated experiment media. Scripts and small JSON/Markdown reports stay.
experiments/out/**/*.jpg
experiments/out/**/*.jpeg
experiments/out/**/*.png
experiments/out/**/*.mp3
experiments/out/**/*.flac
experiments/out/**/*.ogg

# Mic debug recordings
server/debug/

# Session file some tools drop at the repo root
:memory:.ses

# Pan/tilt CAD (Fusion archive, STLs, generator): kept locally and in Fusion, not in the repo
docs/cad/

# Codex CLI project config (written by the Fusion MCP add-in)
.codex/
