# Copy to .env (git-ignored) and fill in. Loaded by brain/config.py on start.

# Key for the language model behind Rocky. OpenRouter by default
# (openrouter.ai/keys). An Anthropic or OpenAI key works when LLM_BASE_URL
# and MODEL below point at that provider. See brain/config.py for examples.
LLM_API_KEY=

# Optional. Blank, or only whitespace, keeps the defaults:
#   https://openrouter.ai/api/v1
#   anthropic/claude-haiku-4.5
# The model must accept images and tool calls.
LLM_BASE_URL=
MODEL=

# fish.audio/app/api-keys — Rocky's voice (optional; falls back to the Mac's voice)
FISH_AUDIO_API_KEY=

# What Rocky calls you
HUMAN_NAME=

# Shared secret the robot must present when it connects (also in firmware/include/secrets.h)
ROBOT_TOKEN=

# Mac microphone and camera when the robot is offline. Comma-separated names,
# favourite first (a substring is enough: "PowerConf", "FaceTime"). The first
# one that is plugged in wins. If none are, the built-in mic / camera is used.
# Leave empty for the system default mic and the built-in camera.
# python -m sounddevice lists microphones.
MIC_DEVICE=
CAMERA_DEVICE=

# Optional: where the two turn-detection models are cached on first run.
# Default is ~/.cache/desk-robot/ (the speech model goes to ~/.cache/huggingface/).
DESK_ROBOT_CACHE=

# Home Assistant, read-only. Rocky's get_home_state tool reads one HA_*
# name through brain/home_assistant.py. It cannot change a device.
# URL is the origin only, with no path and no /api, for example
# http://homeassistant.local:8123
# Token: Home Assistant → profile → Security → Long-lived access tokens.
# Leave both blank to keep the adapter unconfigured (it returns not_configured).
# Restart Rocky after changing this file.
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=

# One readable state per line. The key is Rocky's semantic name:
# HA_LIVING_ROOM_TEMPERATURE becomes living_room_temperature.
# The value is the Home Assistant entity id (Settings → Devices & services
# → Entities, or Developer tools → States). The example shape is not your id.
# A bare id must be a number. number: is the same. text: allows a short
# string such as on or idle. The entity's domain is not used to decide.
# At most 32 lines. A line here lets Rocky read that state. It does not
# let him change the device. HOME_ASSISTANT_ENTITY_* is no longer read.
HA_POOL_TEMPERATURE=
HA_OFFICE_TEMPERATURE=
HA_PRINTER_PROGRESS=
HA_PRINTER_NOZZLE_TEMPERATURE=
HA_PRINTER_BED_TEMPERATURE=
# HA_OFFICE_DESK_LAMP=text:switch.office_desk_lamp
